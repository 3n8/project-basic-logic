{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/3n8/project-basic-logic/schemas/align-segment.schema.json",
  "title": "Aligner segment output for project-basic-logic",
  "description": "JSON shape produced by ghcr.io/3n8/qwen3-aligner; one row per word/phrase.",
  "type": "object",
  "required": ["model", "duration", "segments"],
  "additionalProperties": true,
  "properties": {
    "model": {
      "type": "string",
      "description": "Aligner model identifier; matters for reproducibility logs."
    },
    "language": {
      "type": ["string", "null"],
      "description": "ISO-639-1 hint, or null if auto-detected."
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "description": "Total audio duration in seconds."
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "start", "end"],
        "additionalProperties": true,
        "properties": {
          "text":      { "type": "string", "minLength": 1 },
          "start":     { "type": "number", "minimum": 0 },
          "end":       { "type": "number", "exclusiveMinimum": 0 },
          "score":     { "type": ["number", "null"] }
        }
      }
    }
  }
}
