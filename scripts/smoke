#!/usr/bin/env bash
# scripts/smoke — generate the tiny fixture and run the pipeline end to end.
# Covers all three caption modes. Budget: < 90 s; uses X264_PRESET=veryfast so the
# plumbing, not the encoder, is what gets tested.

set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE/.."
# shellcheck source=lib/common.sh
source "$HERE/../lib/common.sh"

export X264_PRESET="${SMOKE_X264_PRESET:-veryfast}"

start="$(date +%s)"

bin/make-smoke-fixture.sh inputs/smoke

# check_master <path> <expect_subs: yes|no>
check_master() {
    local m="$1" want="$2" got
    [ -s "$m" ] || die "smoke: no master produced at $m"
    got="$(ffprobe -v error -select_streams s -show_entries stream=index -of csv=p=0 "$m" | head -1)"
    if [ "$want" = "yes" ]; then
        [ -n "$got" ] || die "smoke: expected a subtitle track in $m, found none"
    else
        [ -z "$got" ] || die "smoke: expected no subtitle track in $m, found one"
    fi
}

for mode in burn soft off; do
    rm -rf "outputs/smoke-$mode"
    bin/render-master.sh --captions "$mode" \
        "smoke-$mode" "outputs/smoke-$mode/master.mp4" inputs/smoke outputs
done

check_master outputs/smoke-burn/master.mp4 no    # burned into the picture, no separate track
check_master outputs/smoke-soft/master.mp4 yes   # a real, switchable subtitle track
check_master outputs/smoke-off/master.mp4  no    # no subtitles at all

elapsed=$(( $(date +%s) - start ))
log "smoke: caption modes burn/soft/off OK in ${elapsed}s"

if [ "$elapsed" -ge 90 ]; then
    die "smoke: ${elapsed}s exceeds the 90s budget"
fi

log "smoke: pass"
